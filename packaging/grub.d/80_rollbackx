#!/bin/sh
# /etc/grub.d/80_rollbackx — RollbackX snapshot boot menüsü
# python3 ve rollbackx binary'sine bağımlılık YOK — doğrudan JSON okur.

DB="/var/lib/rollbackx/snapshots.json"
[ -f "$DB" ] || exit 0

# Boş veya boş array kontrolü
CONTENT=$(cat "$DB" 2>/dev/null)
[ -z "$CONTENT" ] && exit 0
[ "$CONTENT" = "[]" ] && exit 0

# Mevcut kernel ve initrd'yi bul (en yenisi)
KERNEL=$(ls /boot/vmlinuz-* 2>/dev/null | sort -V | tail -1)
INITRD=$(ls /boot/initrd.img-* 2>/dev/null | sort -V | tail -1)
[ -z "$KERNEL" ] && exit 0

# Root FS UUID
ROOT_UUID=""
if command -v findmnt >/dev/null 2>&1; then
    ROOT_UUID=$(findmnt -n -o UUID / 2>/dev/null)
fi
if [ -z "$ROOT_UUID" ] && command -v grub-probe >/dev/null 2>&1; then
    ROOT_UUID=$(grub-probe --target=fs_uuid / 2>/dev/null)
fi
[ -z "$ROOT_UUID" ] && exit 0

# JSON'dan snapshot bilgilerini parse et (python3/jq'suz)
# Pretty-printed JSON'dan id, name, created_at, backend alanlarını çek
parse_snapshots() {
    CUR_ID=""
    CUR_NAME=""
    CUR_DATE=""
    CUR_BACKEND=""

    while IFS= read -r line; do
        case "$line" in
            *'"id"'*)
                CUR_ID=$(echo "$line" | sed 's/[^0-9]//g')
                ;;
            *'"name"'*)
                CUR_NAME=$(echo "$line" | sed 's/.*"name"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/')
                ;;
            *'"created_at"'*)
                CUR_DATE=$(echo "$line" | sed 's/.*"created_at"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/' | cut -c1-16 | tr 'T' ' ')
                ;;
            *'"backend"'*)
                CUR_BACKEND=$(echo "$line" | sed 's/.*"backend"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/')
                ;;
            *'}'*)
                # Obje sonu — bu snapshot'ı yazdır
                if [ -n "$CUR_ID" ] && [ -n "$CUR_NAME" ]; then
                    echo "${CUR_ID}|${CUR_NAME}|${CUR_DATE}|${CUR_BACKEND}"
                fi
                CUR_ID=""
                CUR_NAME=""
                CUR_DATE=""
                CUR_BACKEND=""
                ;;
        esac
    done < "$DB"
}

ENTRIES=$(parse_snapshots)
[ -z "$ENTRIES" ] && exit 0

cat << 'GRUB_HEADER'
submenu 'RollbackX -- Anlık Görüntüler' {
GRUB_HEADER

echo "$ENTRIES" | while IFS="|" read -r SNAP_ID SNAP_NAME SNAP_DATE SNAP_BACKEND; do
    [ -z "$SNAP_ID" ] && continue
    cat << EOF
    menuentry 'RollbackX: ${SNAP_NAME} (${SNAP_DATE}) [${SNAP_BACKEND}]' --class rollbackx {
        insmod part_gpt
        insmod ext2
        insmod btrfs
        search --no-floppy --fs-uuid --set=root ${ROOT_UUID}
        echo 'RollbackX: Geri yukleniyor -- ${SNAP_NAME}'
        linux   ${KERNEL} root=UUID=${ROOT_UUID} rw rollbackx.restore_id=${SNAP_ID} init=/usr/lib/rollbackx/emergency-restore.sh
        initrd  ${INITRD}
    }
EOF
done

echo "}"
